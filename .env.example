# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# DATABASE - NEON POSTGRESQL
# ==========================================
DATABASE_URL=postgresql://username:password@ep-example-host.aws.neon.tech/neondb?sslmode=require

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN="7d"

# ==========================================
# FRONTEND / CORS
# ==========================================
CLIENT_URL="http://localhost:5173"
API_URL="http://localhost:5000"

# ==========================================
# CLOUDINARY MEDIA STORAGE
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER="peoplepay360"

# ==========================================
# NODEMAILER SMTP EMAIL DELIVERY
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
MAIL_FROM_NAME="PeoplePay360"
MAIL_FROM_EMAIL=your_email@gmail.com

# ==========================================
# APPLICATION METADATA
# ==========================================
CURRENCY="INR"
COMPANY_NAME="PeoplePay360"
